# Virtual environment
project_venv/
venv/
*.egg-info/

# Python cache
__pycache__/
*.pyc

# Environment variables / secrets
.env

# Generated data / pipeline output
data/
raw_data/
logs/
/artifacts/
output/

# JDBC driver jars (large binary, environment-specific)
jars/

# Spark
*.log
metastore_db/
derby.log

# OS junk
.DS_Store
__MACOSX/

# IDE
.vscode/
.idea/
# ---------------------------------------------------------------- Terraform
# State files contain secrets (RDS password, IAM keys) — never commit these
terraform-wind-turbine/**/.terraform/
terraform-wind-turbine/**/*.tfstate
terraform-wind-turbine/**/*.tfstate.backup
terraform-wind-turbine/**/.terraform.lock.hcl

# Personal settings containing your email, IP, Snowflake account
terraform-wind-turbine/**/terraform.tfvars

# Backend config contains your state bucket name
terraform-wind-turbine/**/backend.hcl

# ---------------------------------------------------------------- Build artefacts
# Generated by build.sh — large files, rebuilt on demand
aws_dropin/build/

# ---------------------------------------------------------------- AWS credentials
# Uploader state file tracks which files have been uploaded
.wind_turbine_uploader_state.json

# ---------------------------------------------------------------- SSH keys
*.pem

# Terraform provider binaries and lock files
terraform-wind-turbine/**/.terraform/
terraform-wind-turbine/**/.terraform.lock.hcl

# Terraform state files (contain secrets)
terraform-wind-turbine/**/terraform.tfstate
terraform-wind-turbine/**/terraform.tfstate.backup

# Build artefacts (generated by build.sh)
aws_dropin/build/
